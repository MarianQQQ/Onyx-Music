{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onyx Music",
  "version": "0.2.0",
  "identifier": "com.marian.onyx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onyx Music",
        "width": 1100,
        "height": 650,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#000000",
        "visible": false,
        "maximized": false,
        "additionalBrowserArgs": "--js-flags=--max-old-space-size=64 --disable-features=Translate,OptimizationHints,MediaRouter"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
